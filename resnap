#!/bin/bash
# Full-disk backup to USB drives via restic.
# Must be run as root. Deploy to /usr/local/bin/resnap.
set -euo pipefail

DRIVES_FILE="/usr/local/etc/resnap/drives"
EXCLUDES_FILE="/usr/local/etc/resnap/excludes"
PASSWORD_FILE="/usr/local/etc/resnap/password"
MOUNT_BASE="/mnt"
REPO_DIR="restic"
CACHE_DIR="/var/cache/resnap"
LOCK_FILE="/var/run/resnap.lock"
SUBSET_TOTAL=20

export RESTIC_PASSWORD_FILE="$PASSWORD_FILE"
export RESTIC_CACHE_DIR="$CACHE_DIR"
RESTORE_SCRIPT="$(dirname "$(realpath "$0")")/resnap-restore"

CURRENT_MOUNT=""

cleanup() {
    if [[ -n "$CURRENT_MOUNT" ]]; then
        warn "Interrupted; unmounting $CURRENT_MOUNT..."
        umount "$CURRENT_MOUNT" 2>/dev/null || true
    fi
    exit 130
}
trap cleanup INT TERM

usage() {
    cat >&2 <<EOF
Usage: resnap [mode] [name ...]

  default        Backup, prune, and run a rotating subset check (default)
  backup         Backup and prune only; skip integrity check
  check          Rotating subset check only; skip backup
  full-check     Backup, prune, and run a full integrity check; resets subset counter

  name           One or more drive names to process; omit to process all drives
EOF
}

log()  { echo "$(date -Iseconds) $*";              logger -t resnap                "$*"; }
warn() { echo "$(date -Iseconds) WARNING: $*" >&2; logger -t resnap -p user.warning "WARNING: $*"; }
err()  { echo "$(date -Iseconds) ERROR: $*"   >&2; logger -t resnap -p user.error   "ERROR: $*";   }

backup_drive() {
    local name="$1"
    local uuid="$2"
    local required="${3:-0}"
    local dev="/dev/disk/by-uuid/$uuid"
    local mountpoint="$MOUNT_BASE/$uuid"
    local repo="$mountpoint/$REPO_DIR"
    local subset_file="$mountpoint/check.subset"

    if [[ ! -e "$dev" ]]; then
        if (( required )); then
            err "$name: not found."
            return 1
        fi
        log "$name: not found, skipping."
        return 0
    fi

    log "$name: found."
    mkdir -p "$mountpoint"
    local do_umount=0
    if mountpoint -q "$mountpoint"; then
        log "$name: already mounted at $mountpoint, skipping mount."
    else
        CURRENT_MOUNT="$mountpoint"
        mount "$dev" "$mountpoint"
        do_umount=1
    fi

    local rc=0
    (
        set -euo pipefail

        if [[ -f "$repo/config" ]]; then
            restic -r "$repo" unlock
        elif [[ "$MODE" == "default" || "$MODE" == "backup" ]]; then
            log "$name: initializing new repository..."
            restic -r "$repo" init
        else
            err "$name: no repository found at $repo (run in default or backup mode to initialize)"
            exit 1
        fi

        if [[ "$MODE" == "default" || "$MODE" == "backup" ]]; then
            log "$name: starting backup..."
            restic -r "$repo" backup \
                --verbose \
                --no-scan \
                --compression auto \
                --exclude-caches \
                --one-file-system \
                --exclude-file "$EXCLUDES_FILE" \
                /

            log "$name: pruning old snapshots..."
            restic -r "$repo" forget \
                --verbose \
                --keep-daily 14 \
                --keep-weekly 8 \
                --keep-monthly 12 \
                --keep-yearly 3 \
                --prune

            log "$name: updating recovery files..."
            mkdir -p "$mountpoint/recover"
            cp "$(command -v restic)" "$mountpoint/recover/restic"
            cp "$RESTORE_SCRIPT" "$mountpoint/recover/resnap-restore"
            chmod 755 "$mountpoint/recover/restic" "$mountpoint/recover/resnap-restore"
        fi

        case "$MODE" in
            default|check)
                n=$(( ( $(cat "$subset_file" 2>/dev/null || echo 0) % SUBSET_TOTAL ) + 1 ))
                log "$name: checking repository (subset ${n}/${SUBSET_TOTAL})..."
                restic -r "$repo" check --with-cache --read-data-subset="${n}/${SUBSET_TOTAL}"
                echo "$n" > "$subset_file"
                ;;
            full-check)
                log "$name: running full integrity check..."
                restic -r "$repo" check --with-cache --read-data
                rm -f "$subset_file"
                log "$name: subset counter reset."
                ;;
        esac
    ) || rc=$?

    if (( do_umount )); then
        log "$name: unmounting..."
        umount "$mountpoint" || warn "$name: failed to unmount $mountpoint"
        CURRENT_MOUNT=""
    fi

    return $rc
}

MODE="${1:-default}"
case "$MODE" in
    default|backup|check|full-check) ;;
    *) usage; exit 1 ;;
esac
shift || true
FILTER_NAMES=("$@")

exec 9>"$LOCK_FILE"
flock -n 9 || { err "Another instance is already running."; exit 1; }

mkdir -p "$CACHE_DIR"

[[ -s "$PASSWORD_FILE" ]] || { err "Password file is missing or empty: $PASSWORD_FILE"; exit 1; }
[[ -f "$DRIVES_FILE"   ]] || { err "Drives file not found: $DRIVES_FILE";    exit 1; }
grep -qvE '^\s*(#|$)' "$DRIVES_FILE" || { err "Drives file is empty: $DRIVES_FILE"; exit 1; }
[[ -f "$EXCLUDES_FILE" ]] || { err "Excludes file not found: $EXCLUDES_FILE"; exit 1; }

declare -A filter_matched
for f in "${FILTER_NAMES[@]}"; do filter_matched["$f"]=0; done

errors=0
while read -r name uuid || [[ -n "${name:-}" ]]; do
    [[ -z "${name:-}" || "${name:0:1}" == "#" ]] && continue
    local_required=0
    if (( ${#FILTER_NAMES[@]} > 0 )); then
        match=0
        for f in "${FILTER_NAMES[@]}"; do [[ "$f" == "$name" ]] && match=1 && break; done
        (( match )) || continue
        filter_matched["$name"]=1
        local_required=1
    fi
    backup_drive "$name" "$uuid" "$local_required" || { err "$name: backup failed."; errors=$(( errors + 1 )); }
done < "$DRIVES_FILE"

for f in "${FILTER_NAMES[@]}"; do
    if (( ! filter_matched["$f"] )); then
        err "Unknown drive name: $f"
        errors=$(( errors + 1 ))
    fi
done

if (( errors > 0 )); then
    err "$errors drive(s) failed."
    exit 1
fi

log "All drives processed successfully."
